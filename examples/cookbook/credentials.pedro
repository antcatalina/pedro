# Register an account with a hashed password, then verify a login attempt.
# A second effectful example: database + crypto through the adapter layer, with an
# `expect` block proving the whole round-trip against in-memory mock adapters.
target: python

use capability database
use capability crypto

record Account:
    username: text
    password_hash: text
    id: text = ""

table accounts: Account

task register(username: text, password: text) returns text:
    let hashed = hash password
    return insert into accounts { username: username, password_hash: hashed }

task login(username: text, password: text) returns flag:
    let account = find one a in accounts where a.username is username
    when account is nothing:
        return false
    return verify password against account.password_hash

expect:
    given accounts is empty
    register("ada", "s3cret") is present
    login("ada", "s3cret") == true
    login("ada", "wrong") == false
    login("ghost", "whatever") == false
