# Compute an order total, applying a percentage discount.
# A free-shipping tier (subtotal over 100) gets an extra 5% off.
target: python 3.11

record LineItem:
    name: text
    price: number
    quantity: whole

# pedro-note: a collection binds to its record type EXPLICITLY, through the type
# annotation — `items: list of LineItem` says these rows are LineItems. Pedro never
# infers a row type from a collection's NAME (no `items` -> `Item` pluralization
# magic); the type is always written down. The same rule will govern a future
# `database` capability: a table declares its record type, it is not guessed.
task order_total(items: list of LineItem, discount_percent: number) returns number:
    let subtotal = 0
    for each item in items:
        increase subtotal by item.price * item.quantity

    when subtotal is greater than 100:
        # free-shipping tier gets an extra 5% off
        increase discount_percent by 5

    let discount = subtotal * discount_percent / 100
    return subtotal - discount

expect:
    order_total([ { name: "pen",  price: 2.5, quantity: 4 } ], 0)  == 10
    order_total([ { name: "desk", price: 120, quantity: 1 } ], 10) == 102
