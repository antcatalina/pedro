# Sign a new user up: validate the email, reject duplicates,
# hash the password, store the user, and send a welcome email.
target: python 3.11

use capability database
use capability email
use capability crypto

# pedro-note: this file is a DESIGN example — capabilities (`use capability …`)
# aren't in the compiler yet, so it does not compile. It shows the resolved rule
# for how a table binds to a record: EXPLICITLY, not by naming convention. A
# future `database` capability will require the row type to be declared (e.g.
# `table users: User`), so `users` holds `User` rows because it is stated — Pedro
# never singularizes `users` into `User`. See docs/language-card.md ("Records").
record User:
    id: text
    email: text
    password: text

task sign_up(email: text, password: text) returns text:
    when email is not a valid email:
        fail with "invalid email"

    let existing = find one user in users where user.email is email
    when existing is present:
        fail with "email already registered"

    let hashed = hash password
    let new_id = insert into users { email: email, password: hashed }
    send email to email with subject "Welcome!" body "Thanks for signing up."
    return new_id

expect:
    given users is empty
    sign_up("ada@example.com", "s3cret") is present
    sign_up("not-an-email", "s3cret") fails with "invalid email"
