# Sign a new user up: validate the email, reject duplicates, hash the password,
# store the user, and send a welcome email. This is the capability showcase —
# database + email + crypto, each routed through the swappable adapter layer, and
# every effect declared up front so the program's blast radius is auditable.
target: python

use capability database
use capability email
use capability crypto

record User:
    email: text
    password: text
    id: text = ""            # assigned by the database on insert

# pedro-note: a table binds its row type EXPLICITLY (`table users: User`) — Pedro
# never singularizes `users` into `User`. `users` is a table handle: iterable, so
# `find one user in users …` reuses the ordinary comprehension path.
table users: User

task sign_up(email: text, password: text) returns text:
    when "@" not in email:
        fail with "invalid email"

    let existing = find one user in users where user.email is email
    when existing is present:
        fail with "email already registered"

    let hashed = hash password
    let new_id = insert into users { email: email, password: hashed }
    # `email` (the adapter) collides with the `email` parameter, so pedroc imports
    # it as `mailer` — the import is renamed, never the user's identifier.
    send email to email with subject "Welcome!" body "Thanks for signing up."
    return new_id

expect:
    given users is empty
    sign_up("ada@example.com", "s3cret") is present
    sign_up("not-an-email", "s3cret") fails with "invalid email"
    sign_up("ada@example.com", "again") fails with "email already registered"
